# All variables below are OPTIONAL. The pipeline runs fully end-to-end with
# none of them set, using local heuristics/templates and a local outbox
# folder instead of live publishing.

# --- LLM enhancement (optional) ---
# If set, clip-selector and content-repurposer use LLM JSON-mode generation
# instead of the built-in heuristic/template fallback. Anthropic is preferred
# if both are set (see pipeline/llm.py::get_llm_client).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Publishing (optional) ---
# If unset, `publish` writes a local runs/<id>/outbox/ folder per run for
# manual posting instead of calling a live API. Requires
# `pip install -e ".[publish]"` (adds the `requests` package) to actually
# reach either live API -- without it, publish reports a clear per-post
# failure rather than crashing.
#
# Blotato is preferred over Ayrshare if both are set (cheaper, real REST
# API). Blotato also needs a per-platform account id -- get yours from your
# Blotato dashboard's connected accounts, one per platform you want to post
# to. Neither provider can receive local clip video -- both need a
# publicly-hosted media URL, so live publish here is text-only; anything
# needing video still goes through the outbox.
BLOTATO_API_KEY=
BLOTATO_ACCOUNT_IDS={}
AYRSHARE_API_KEY=

# --- Audio enhancement (optional, zero-key -- ffmpeg-only by default) ---
# The `enhance` stage denoises + normalizes source audio to a target LUFS
# before transcribe. AUDIO_TARGET_LUFS defaults to -16.0 (a common
# short-form-platform loudness target). RNNOISE_MODEL_PATH is opt-in deeper
# denoise (arnndn) -- ffmpeg doesn't ship a model file, so this stays unset
# (afftdn, no model needed) unless you supply your own .rnnn model.
AUDIO_TARGET_LUFS=-16.0
RNNOISE_MODEL_PATH=

# --- Transcription + diarization backend (optional) ---
# Zero-key default: local faster-whisper, single speaker (SPEAKER_00), no
# diarization. See pipeline/transcribe.py::get_transcribe_backend for the
# full precedence ladder. ElevenLabs Scribe (paid) replaces the whole
# transcribe call and bundles diarization + audio-event tags (laughter,
# applause, ...) in one request -- UNVERIFIED, reconstructed from
# documentation, not confirmed against a live key (api.elevenlabs.io was
# egress-blocked during implementation; same caveat as Blotato above).
# pyannote.audio (free but gated) adds a diarization overlay on top of the
# local transcript -- get a HUGGINGFACE_TOKEN and accept
# pyannote/speaker-diarization-3.1's license on huggingface.co first.
# Requires `pip install -e ".[elevenlabs]"` or `pip install -e ".[diarize]"`
# respectively.
ELEVENLABS_API_KEY=
HUGGINGFACE_TOKEN=
# TRANSCRIBE_BACKEND=auto picks ElevenLabs automatically once a key is set;
# force =local to keep using faster-whisper even with a key configured.
TRANSCRIBE_BACKEND=auto
# DIARIZATION_BACKEND=auto picks pyannote automatically once a token is
# set; force =none to skip the overlay (and its first-run model download)
# without unsetting the token for other uses.
DIARIZATION_BACKEND=auto

# --- Motion graphics (optional, zero-key -- skipped without both an LLM
# key above AND a working local Node/HyperFrames setup) ---
# See graphics/README-equivalent docs: graphics/MOTION.md and
# skills/motion-designer/SKILL.md. `cd graphics && npm install` first.
GRAPHICS_PROJECT_DIR=graphics
GRAPHICS_MAX_BEATS=4
NPX_BIN=npx
RENDER_TIMEOUT_S=600

# --- Local config (optional, has sane defaults) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
DATA_DIR=runs
