# All variables below are OPTIONAL. The pipeline runs fully end-to-end with
# none of them set, using local heuristics/templates and a local outbox
# folder instead of live publishing.

# --- LLM enhancement (optional) ---
# If set, clip-selector and content-repurposer use LLM JSON-mode generation
# instead of the built-in heuristic/template fallback. Anthropic is preferred
# if both are set (see pipeline/llm.py::get_llm_client).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Publishing (optional) ---
# If unset, `publish` writes a local runs/<id>/outbox/ folder per run for
# manual posting instead of calling a live API.
AYRSHARE_API_KEY=

# --- Local config (optional, has sane defaults) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
DATA_DIR=runs
